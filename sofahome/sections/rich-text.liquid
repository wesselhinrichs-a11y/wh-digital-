<section class="section">
  <div class="page-width page-width--narrow" style="text-align: {{ section.settings.alignment }}">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="rte">{{ section.settings.text }}</div>
    {%- if section.settings.button_label != blank -%}
      <p style="margin-top:1.75rem">
        <a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Tekstblok",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Bovenkopje" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Kiezen doe je thuis, niet in een showroom" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Tekst",
      "default": "<p>Bestel gratis vijf stalen en leg ze een week op je bank. Zo zie je hoe een stof er 's ochtends uitziet en hoe 's avonds. Pas als het klopt, bestel je.</p>"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Uitlijning",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "center", "label": "Gecentreerd" }
      ],
      "default": "center"
    },
    { "type": "text", "id": "button_label", "label": "Knoptekst" },
    { "type": "url", "id": "button_link", "label": "Knoplink" }
  ],
  "presets": [{ "name": "Tekstblok" }]
}
{% endschema %}
