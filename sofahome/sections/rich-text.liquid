<section class="section">
  <div class="page-width page-width--narrow" style="text-align: {{ section.settings.alignment }}">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="rte">{{ section.settings.text }}</div>
    {%- if section.settings.button_label != blank -%}
      <p style="margin-top:1.75rem">
        <a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Tekstblok",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Bovenkopje" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Uitgerust wakker worden begint bij wat je gezicht raakt" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Tekst",
      "default": "<p>Zeven, acht uur per nacht ligt je huid tegen je kussen. Katoen trekt vocht weg en geeft wrijving; zijde doet geen van beide. Minder slaapvouwen, minder klit in je haar, en met een masker dat licht buitensluit ook minder halfwakkere uren.</p>"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Uitlijning",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "center", "label": "Gecentreerd" }
      ],
      "default": "center"
    },
    { "type": "text", "id": "button_label", "label": "Knoptekst" },
    { "type": "url", "id": "button_link", "label": "Knoplink" }
  ],
  "presets": [{ "name": "Tekstblok" }]
}
{% endschema %}
