<section class="section">
  <div class="page-width">
    <div class="newsletter">
      <div>
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="lede" style="margin-inline:auto">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>

      {%- form 'customer', class: 'newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="NewsletterEmail">{{ 'general.newsletter_form.label' | t }}</label>
        <input
          class="field"
          id="NewsletterEmail"
          type="email"
          name="contact[email]"
          autocomplete="email"
          placeholder="{{ 'general.newsletter_form.placeholder' | t }}"
          required
        >
        <button class="button" type="submit">{{ 'general.newsletter_form.submit' | t }}</button>

        {%- if form.posted_successfully? -%}
          <p class="form-note" style="color:inherit">{{ 'general.newsletter_form.confirmation' | t }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Nieuwsbrief",
  "settings": [
    { "type": "text", "id": "heading", "label": "Kop", "default": "Nieuwe stoffen, nieuwe modellen" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Tekst",
      "default": "Eén mail per maand. Als eerste zien wat er nieuw is, en af en toe iets dat alleen voor de lijst geldt."
    }
  ],
  "presets": [{ "name": "Nieuwsbrief" }]
}
{% endschema %}
