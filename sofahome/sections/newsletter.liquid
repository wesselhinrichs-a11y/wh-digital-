<section
  class="newsletter"
  style="--newsletter-bg: {{ section.settings.background }}; --newsletter-ink: {{ section.settings.button_color }}"
>
  <div class="page-width">
    <div class="newsletter__inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h2 class="newsletter__heading">{{ section.settings.heading }}</h2>

      {%- if section.settings.text != blank -%}
        <p class="newsletter__text">{{ section.settings.text }}</p>
      {%- endif -%}

      {%- form 'customer', class: 'newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="NewsletterEmail">{{ 'general.newsletter_form.label' | t }}</label>
        <input
          class="newsletter__field"
          id="NewsletterEmail"
          type="email"
          name="contact[email]"
          autocomplete="email"
          placeholder="{{ 'general.newsletter_form.placeholder' | t }}"
          required
        >
        <button class="newsletter__button" type="submit">
          {%- if section.settings.button_label != blank -%}
            {{ section.settings.button_label }}
          {%- else -%}
            {{ 'general.newsletter_form.submit' | t }}
          {%- endif -%}
        </button>

        {%- if form.posted_successfully? -%}
          <p class="newsletter__note">{{ 'general.newsletter_form.confirmation' | t }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Nieuwsbrief",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label erboven", "default": "Blijf op de hoogte" },
    {
      "type": "text",
      "id": "heading",
      "label": "Kop",
      "default": "Als eerste op de hoogte van nieuwe collecties"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Tekst",
      "default": "Geen spam, alleen updates die ertoe doen.",
      "info": "Houd het bij één korte zin."
    },
    { "type": "text", "id": "button_label", "label": "Knoptekst", "default": "Aanmelden" },
    {
      "type": "color",
      "id": "background",
      "label": "Achtergrond",
      "default": "#f3efe8",
      "info": "Zacht en neutraal. Crème, off-white of een lichte lavendel."
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Knopkleur",
      "default": "#1c1917",
      "info": "Effen donker, zonder schaduw."
    }
  ],
  "presets": [{ "name": "Nieuwsbrief" }]
}
{% endschema %}
