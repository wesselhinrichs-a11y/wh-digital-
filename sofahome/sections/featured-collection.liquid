{%- assign collection = section.settings.collection -%}

<section class="section">
  <div class="page-width">
    <div class="section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>

      {%- if collection != blank -%}
        <a class="link-arrow" href="{{ collection.url }}">{{ section.settings.link_label }} &rarr;</a>
      {%- endif -%}
    </div>

    <div class="grid grid--{{ section.settings.columns }}">
      {%- if collection != blank -%}
        {%- for product in collection.products limit: section.settings.product_limit -%}
          {% render 'product-card', product: product, show_vendor: section.settings.show_vendor %}
        {%- else -%}
          <p>{{ 'collections.general.no_matches' | t }}</p>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Placeholders zodat de sectie ook zonder gekozen collectie iets laat zien {%- endcomment -%}
        {%- for i in (1..section.settings.product_limit) -%}
          <div class="card">
            <div class="card__media"><div class="placeholder-tile"></div></div>
            <div>
              <h3 class="card__title">{{ 'onboarding.product_title' | t }}</h3>
              <div class="price"><span class="price__regular">{{ 129900 | money }}</span></div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Uitgelichte collectie",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collectie"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Bovenkopje",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Kop",
      "default": "Waar je 's ochtends het verschil mee voelt"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link naar collectie",
      "default": "Bekijk alles"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Aantal producten",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Kolommen",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Merk tonen",
      "default": false
    }
  ],
  "presets": [{ "name": "Uitgelichte collectie" }]
}
{% endschema %}
