<section class="section">
  <div class="page-width">
    <div class="split split--fill {% if section.settings.reverse %}split--reverse{% endif %}">
      <div class="split__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              widths: '500, 800, 1100, 1400',
              sizes: '(min-width: 750px) 50vw, 100vw',
              loading: 'lazy',
              alt: section.settings.image.alt | default: section.settings.heading | escape
          }}
        {%- else -%}
          <div class="placeholder-tile"></div>
        {%- endif -%}
      </div>

      <div class="split__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        <h2>{{ section.settings.heading }}</h2>

        {%- if section.settings.text != blank -%}
          <div class="rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <p style="margin-top:1.5rem">
            <a class="button button--secondary" href="{{ section.settings.button_link }}">
              {{ section.settings.button_label }}
            </a>
          </p>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="specs">
            {%- for block in section.blocks -%}
              <li class="specs__item" {{ block.shopify_attributes }}>
                <span class="specs__icon">{% render 'icon', icon: block.settings.icon %}</span>
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.note != blank -%}
      <p class="specs__note">{{ section.settings.note }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Het materiaal",
  "max_blocks": 4,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Foto", "info": "Close-up van de stof." },
    { "type": "checkbox", "id": "reverse", "label": "Foto rechts", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Label erboven", "default": "Het materiaal" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "22 momme, gemaakt om te voelen" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Tekst",
      "default": "<p>Zeven, acht uur per nacht ligt je huid tegen je kussen. Katoen trekt vocht uit je huid en je haar, en geeft weerstand bij elke beweging die je maakt. Dat zie je 's ochtends terug: strepen in je gezicht die er een uur over doen om weg te trekken, haar dat klit, een huid die droger aanvoelt dan toen je ging slapen.</p><p>Silk doet geen van beide. Het glijdt mee in plaats van te trekken, en laat het vocht zitten waar het hoort. Hoe dichter het weefsel — dat is precies wat momme meet — hoe soepeler het aanvoelt en hoe beter het tegen wassen kan. Veel webshops blijven onder de 12 momme; daar begint silk pas op silk te lijken.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Knoptekst", "info": "Leeg laten voor geen knop." },
    { "type": "url", "id": "button_link", "label": "Knoplink" },
    {
      "type": "textarea",
      "id": "note",
      "label": "Slotzin",
      "default": "Waar andere merken je laten betalen voor de naam, betaal je bij ons voor het materiaal zelf."
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Kenmerk",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icoon",
          "options": [
            { "value": "swatch", "label": "Stof" },
            { "value": "ruler", "label": "Maat" },
            { "value": "leaf", "label": "Natuurlijk" },
            { "value": "shield", "label": "Bescherming" },
            { "value": "star", "label": "Ster" }
          ],
          "default": "swatch"
        },
        { "type": "text", "id": "text", "label": "Tekst", "default": "22 momme" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Het materiaal",
      "blocks": [
        { "type": "spec", "settings": { "icon": "ruler", "text": "22 momme" } },
        { "type": "spec", "settings": { "icon": "swatch", "text": "100% moerbeizijde" } },
        { "type": "spec", "settings": { "icon": "leaf", "text": "Huidvriendelijk" } }
      ]
    }
  ]
}
{% endschema %}
