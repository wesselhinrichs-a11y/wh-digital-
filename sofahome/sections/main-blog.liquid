<div class="section">
  <div class="page-width">
    <h1>{{ blog.title }}</h1>

    {%- paginate blog.articles by 9 -%}
      <div class="grid grid--3" style="margin-top:2rem">
        {%- for article in blog.articles -%}
          <a class="card" href="{{ article.url }}">
            <div class="card__media">
              {%- if article.image -%}
                {{
                  article.image
                  | image_url: width: 900
                  | image_tag:
                    widths: '300, 500, 700, 900',
                    sizes: '(min-width: 750px) 33vw, 50vw',
                    loading: 'lazy',
                    alt: article.title | escape
                }}
              {%- else -%}
                <div class="placeholder-tile"></div>
              {%- endif -%}
            </div>
            <div>
              <div class="card__vendor">{{ article.published_at | date: '%-d %B %Y' }}</div>
              <h3 class="card__title">{{ article.title }}</h3>
              <p class="card__vendor">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
            </div>
          </a>
        {%- endfor -%}
      </div>

      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
