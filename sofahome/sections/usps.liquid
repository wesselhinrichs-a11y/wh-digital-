<section class="section section--tight">
  <div class="page-width">
    {%- comment -%}
      Op desktop een raster, op telefoon een carrousel: één voordeel in beeld,
      swipen met de vinger en verder rollend op eigen kracht. Het scrollen zelf
      is CSS (scroll-snap); de JS zet alleen de volgende in beeld.
    {%- endcomment -%}
    <div
      class="usps"
      data-usps
      data-interval="{{ section.settings.speed | times: 1000 }}"
    >
      <div class="usps__track grid grid--{{ section.blocks.size | at_most: 4 }}">
        {%- for block in section.blocks -%}
          <div class="usp" {{ block.shopify_attributes }}>
            <div class="usp__icon">{% render 'icon', icon: block.settings.icon %}</div>
            <h3 class="usp__title">{{ block.settings.title }}</h3>
            <p class="usp__text">{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
      </div>

      {%- if section.blocks.size > 1 -%}
        <div class="usps__dots" data-usps-dots aria-hidden="true">
          {%- for block in section.blocks -%}
            <span class="usps__dot {% if forloop.first %}is-active{% endif %}"></span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Waarom Sova Home",
  "max_blocks": 4,
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "Wisselen na",
      "unit": "sec",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 4,
      "info": "Alleen op telefoon, waar de voordelen één voor één in beeld komen."
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "Voordeel",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icoon",
          "options": [
            { "value": "truck", "label": "Bezorging" },
            { "value": "leaf", "label": "Duurzaam" },
            { "value": "shield", "label": "Garantie" },
            { "value": "ruler", "label": "Maatwerk" },
            { "value": "swatch", "label": "Stof" },
            { "value": "star", "label": "Ster" }
          ],
          "default": "swatch"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "19 en 22 momme"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Tekst",
          "default": "Kussenslopen 19, slaapmaskers 22. Veel webshops blijven onder de 12 — dat voelt als polyester."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Waarom Sova Home",
      "blocks": [
        {
          "type": "usp",
          "settings": {
            "icon": "swatch",
            "title": "19 en 22 momme",
            "text": "Kussenslopen 19, slaapmaskers 22. Veel webshops blijven onder de 12 — dat voelt als polyester."
          }
        },
        {
          "type": "usp",
          "settings": {
            "icon": "leaf",
            "title": "Rechtstreeks van de producent",
            "text": "Geen tussenhandel, geen merknaam die je extra betaalt. Alleen het product."
          }
        },
        {
          "type": "usp",
          "settings": {
            "icon": "truck",
            "title": "Gratis verzending",
            "text": "Op elke bestelling, zonder minimumbedrag. Verstuurd op de dag dat je bestelt."
          }
        },
        {
          "type": "usp",
          "settings": {
            "icon": "shield",
            "title": "30 dagen bedenktijd",
            "text": "Slaap er een maand op. Bevalt het niet, dan gaat het terug — ook als het gebruikt is."
          }
        }
      ]
    }
  ]
}
{% endschema %}
