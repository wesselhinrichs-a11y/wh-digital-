<section class="section">
  <div class="page-width">
    <div class="split split--fill {% if section.settings.reverse %}split--reverse{% endif %}">
    {%- liquid
      assign voor = section.settings.image_before
      assign na = section.settings.image_after
      assign gesplitst = false
      assign heeft_vergelijking = false

      if voor != blank and na != blank
        assign heeft_vergelijking = true
        assign verhouding = voor.aspect_ratio
      elsif voor != blank and section.settings.split_image
        # Eén foto waarin voor en na al naast elkaar staan: beide helften komen
        # uit hetzelfde bestand, dus is het kader half zo breed als de foto.
        assign heeft_vergelijking = true
        assign gesplitst = true
        assign na = voor
        assign verhouding = voor.aspect_ratio | divided_by: 2.0
      endif
    -%}

    {%- if heeft_vergelijking -%}
      {%- comment -%}
        Voor/na met een sleepbare scheiding. Beide foto's liggen over elkaar;
        de bovenste wordt bijgesneden met clip-path, zodat er niets verschuift —
        alleen wat je ervan ziet.
      {%- endcomment -%}
      <div
        class="compare {% if gesplitst %}compare--split{% endif %}"
        data-compare
        style="--pos: 50%; --ratio: {{ verhouding }}"
      >
        <div class="compare__pane compare__pane--before">
          {{
            voor
            | image_url: width: 1600
            | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy'
          }}
        </div>

        <div class="compare__pane compare__pane--after">
          {{
            na
            | image_url: width: 1600
            | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy'
          }}
        </div>

        <div class="compare__line">
          <button
            class="compare__handle"
            type="button"
            data-compare-handle
            role="slider"
            aria-orientation="horizontal"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="50"
            aria-label="Vergelijk de twee foto's"
          ></button>
        </div>
      </div>
    {%- else -%}
      <div class="split__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              widths: '500, 800, 1100, 1400',
              sizes: '(min-width: 750px) 50vw, 100vw',
              loading: 'lazy',
              alt: section.settings.image.alt | default: section.settings.heading | escape
          }}
        {%- else -%}
          <div class="placeholder-tile"></div>
        {%- endif -%}
      </div>
    {%- endif -%}

      <div class="split__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        <h2>{{ section.settings.heading }}</h2>

        {%- if section.blocks.size > 0 -%}
          <ul class="benefits">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                <h3 class="benefits__title">{{ block.settings.title }}</h3>
                <p class="benefits__text">{{ block.settings.text }}</p>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <p style="margin-top:2rem">
            <a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
          </p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Voordelen",
  "max_blocks": 6,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Foto" },
    { "type": "checkbox", "id": "reverse", "label": "Foto rechts", "default": true },
    {
      "type": "header",
      "content": "Voor en na",
      "info": "Vul beide foto's in om er een schuifvergelijking van te maken. Blijft er één leeg, dan toont de sectie gewoon de foto hierboven."
    },
    { "type": "image_picker", "id": "image_before", "label": "Foto voor" },
    { "type": "image_picker", "id": "image_after", "label": "Foto na" },
    {
      "type": "checkbox",
      "id": "split_image",
      "label": "Eén foto met voor en na naast elkaar",
      "default": false,
      "info": "Zet dit aan als je één beeld hebt waarin links het voor en rechts het na staat. Zet hem dan bij 'Foto voor'; 'Foto na' laat je leeg."
    },
    { "type": "text", "id": "eyebrow", "label": "Label erboven" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "De voordelen van 100% mulberry silk" },
    { "type": "text", "id": "button_label", "label": "Knoptekst", "default": "Shop kussenslopen" },
    { "type": "url", "id": "button_link", "label": "Knoplink" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Voordeel",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel", "default": "Glijdt, in plaats van trekt" },
        { "type": "textarea", "id": "text", "label": "Tekst" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Voordelen",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "title": "Glijdt, in plaats van trekt",
            "text": "Geen wrijving betekent geen frizz, geen klitten, geen statische ochtendhaar. Alleen rust voor je haar, nacht na nacht."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Ademend van nature",
            "text": "Silk regelt zijn eigen temperatuur, koel wanneer het warm is, warm wanneer het koud is."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Zacht voor de huid",
            "text": "Trekt geen vocht weg, maar houdt het vast. Minder druklijnen, meer rust voor je huid."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Van nature hypoallergeen",
            "text": "Stoot mijten en bacteriën van nature af, gemaakt voor gevoelige huid."
          }
        }
      ]
    }
  ]
}
{% endschema %}
