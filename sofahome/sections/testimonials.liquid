<section class="section">
  <div class="page-width">
    <div class="section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
    </div>

    <div class="grid grid--{{ section.blocks.size | at_most: 3 }}">
      {%- for block in section.blocks -%}
        <figure class="quote" {{ block.shopify_attributes }}>
          {%- if block.settings.rating > 0 -%}
            <div class="stars" aria-label="{{ block.settings.rating }} van 5">
              {%- for i in (1..block.settings.rating) -%}
                {% render 'icon', icon: 'star' %}
              {%- endfor -%}
            </div>
          {%- endif -%}
          <blockquote class="quote__text">{{ block.settings.quote }}</blockquote>
          <figcaption class="quote__author">{{ block.settings.author }}</figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Klantverhalen",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Bovenkopje", "default": "4,8 uit 1.240 beoordelingen" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Wat klanten ervan vinden" }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "label": "Sterren",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "“De stalen kwamen binnen twee dagen. Drie weken later stond de bank er — en hij is precies zo zacht als beloofd.”"
        },
        { "type": "text", "id": "author", "label": "Naam", "default": "Marieke, Utrecht" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Klantverhalen",
      "blocks": [{ "type": "quote" }, { "type": "quote" }, { "type": "quote" }]
    }
  ]
}
{% endschema %}
