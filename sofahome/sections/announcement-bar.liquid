{%- if section.settings.text != blank -%}
  <div class="announcement" style="background: {{ section.settings.background }}; color: {{ section.settings.text_color }};">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
    {%- else -%}
      {{ section.settings.text }}
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Aankondigingsbalk",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Tekst",
      "default": "Gratis bezorging in heel Nederland — levertijd 2 tot 4 weken"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Achtergrond",
      "default": "#1c1917"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Tekstkleur",
      "default": "#faf7f2"
    }
  ]
}
{% endschema %}
