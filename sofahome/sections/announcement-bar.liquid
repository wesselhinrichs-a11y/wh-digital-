{%- if section.blocks.size > 0 -%}
  <div class="announcement" style="background: {{ section.settings.background }}; color: {{ section.settings.text_color }};">
    <div
      class="announcement__viewport"
      data-announcement
      data-interval="{{ section.settings.speed | times: 1000 }}"
    >
      {%- for block in section.blocks -%}
        <div
          class="announcement__item{% if forloop.first %} is-active{% endif %}"
          {% unless forloop.first %}aria-hidden="true"{% endunless %}
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
          {%- else -%}
            {{ block.settings.text }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Aankondigingsbalk",
  "max_blocks": 5,
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Tijd per tekst",
      "default": 5
    },
    {
      "type": "color",
      "id": "background",
      "label": "Achtergrond",
      "default": "#1c1917"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Tekstkleur",
      "default": "#faf7f2"
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Tekst",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Tekst",
          "default": "Gratis verzending"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optioneel."
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "message", "settings": { "text": "Gratis verzending" } },
      { "type": "message", "settings": { "text": "Rechtstreeks van producent, geen tussenhandel" } },
      { "type": "message", "settings": { "text": "30 dagen bedenktijd" } }
    ]
  }
}
{% endschema %}
