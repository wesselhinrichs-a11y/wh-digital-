<div class="section">
  <div class="page-width page-width--narrow" style="max-width:28rem">
    <h1>Nieuw wachtwoord instellen</h1>

    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}
        <p class="form-message">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <div style="margin-bottom:1rem">
        <label for="ResetPassword">Nieuw wachtwoord</label>
        <input class="field" id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>

      <div style="margin-bottom:1.25rem">
        <label for="ResetPasswordConfirm">Herhaal wachtwoord</label>
        <input class="field" id="ResetPasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>

      <button class="button button--full" type="submit">Wachtwoord opslaan</button>
    {%- endform -%}
  </div>
</div>
