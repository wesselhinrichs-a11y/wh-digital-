<div class="page-width page-width--narrow">
  <p class="eyebrow">Binnenkort open</p>
  <h1>{{ shop.name }}</h1>

  {%- if shop.password_message != blank -%}
    <div class="rte lede" style="margin-inline:auto">{{ shop.password_message }}</div>
  {%- else -%}
    <p class="lede" style="margin-inline:auto">
      We leggen de laatste hand aan de winkel. Laat je e-mailadres achter, dan hoor je het als eerste.
    </p>
  {%- endif -%}

  {%- form 'customer', class: 'newsletter__form', style: 'margin:2rem auto 3rem' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <label class="visually-hidden" for="PasswordEmail">{{ 'general.newsletter_form.label' | t }}</label>
    <input class="field" id="PasswordEmail" type="email" name="contact[email]" placeholder="{{ 'general.newsletter_form.placeholder' | t }}" required>
    <button class="button" type="submit">{{ 'general.newsletter_form.submit' | t }}</button>
    {%- if form.posted_successfully? -%}
      <p class="form-note">{{ 'general.newsletter_form.confirmation' | t }}</p>
    {%- endif -%}
  {%- endform -%}

  <details class="accordion" style="max-width:24rem; margin-inline:auto; text-align:left">
    <summary>Ik heb een wachtwoord</summary>
    <div class="accordion__body">
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}
          <p class="form-message">{{ form.errors.messages['form'] }}</p>
        {%- endif -%}
        <label for="StorefrontPassword">Wachtwoord</label>
        <input class="field" id="StorefrontPassword" type="password" name="password" autocomplete="current-password">
        <button class="button button--full" type="submit" style="margin-top:0.75rem">Naar de winkel</button>
      {%- endform -%}
    </div>
  </details>
</div>
